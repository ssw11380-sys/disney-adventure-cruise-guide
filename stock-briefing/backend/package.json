{
  "name": "stock-briefing-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한국 주식 보유 종목 브리핑 앱 백엔드 (Fastify + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "master:refresh": "tsx src/scripts/refreshMaster.ts",
    "briefing": "tsx src/scripts/runBriefing.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.7",
    "@anthropic-ai/sdk": "^0.127.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "kysely": "^0.29.6",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
