# ── 서버 ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Asia/Seoul

# ── 데이터베이스 ─────────────────────────────────────
# 개발: sqlite 파일 경로. ":memory:" 도 가능.
DATABASE_URL=./data/dev.db
# 운영(Postgres): DATABASE_URL=postgres://user:pass@host:5432/dbname
# SSL 은 자동 판단(외부 호스트 켬 / localhost·사설망(.internal)·sslmode=disable 끔). 강제하려면 DATABASE_SSL=true|false

# ── 보안 ─────────────────────────────────────────────
# 서버를 인터넷에 노출한다면 반드시 설정. 앱 설정 화면에 같은 값을 입력한다. (예: openssl rand -hex 24)
API_TOKEN=

# ── 한국투자증권 KIS Open API (시세/차트) ─────────────
# https://apiportal.koreainvestment.com 에서 발급. 비어 있으면 Yahoo Finance로 자동 대체.
KIS_APP_KEY=
KIS_APP_SECRET=
# real | mock  (mock = 모의투자 서버)
KIS_ENV=real

# ── DART Open API (재무제표, 2단계에서 사용) ───────────
DART_API_KEY=

# ── 네이버 검색 API (뉴스, 2단계에서 사용) ────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Anthropic (브리핑 생성, 2단계에서 사용) ───────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── 브리핑 스케줄 (한국 시간, 2단계에서 사용) ──────────
BRIEFING_MORNING_CRON=30 8 * * 1-5
BRIEFING_AFTERNOON_CRON=0 16 * * 1-5

# ── 푸시 알림 (4단계) ────────────────────────────────
# Expo Push Service 는 기본적으로 키가 필요 없다. Expo 계정에서 "Enhanced push security" 를 켠 경우에만 설정.
EXPO_ACCESS_TOKEN=
