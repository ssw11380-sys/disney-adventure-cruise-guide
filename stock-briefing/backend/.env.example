# ── 서버 ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Asia/Seoul

# ── 데이터베이스 ─────────────────────────────────────
# 개발: sqlite 파일 경로. ":memory:" 도 가능.
DATABASE_URL=./data/dev.db
# 운영(Postgres): DATABASE_URL=postgres://user:pass@host:5432/dbname
# SSL 은 자동 판단(외부 호스트 켬 / localhost·사설망(.internal)·sslmode=disable 끔). 강제하려면 DATABASE_SSL=true|false

# ── 보안 ─────────────────────────────────────────────
# 서버를 인터넷에 노출한다면 반드시 설정. 앱 설정 화면에 같은 값을 입력한다. (예: openssl rand -hex 24)
API_TOKEN=

# ── 한국투자증권 KIS Open API (시세/차트) ─────────────
# https://apiportal.koreainvestment.com 에서 발급. 비어 있으면 Yahoo Finance로 자동 대체.
KIS_APP_KEY=
KIS_APP_SECRET=
# real | mock  (mock = 모의투자 서버)
KIS_ENV=real

# ── 토스증권 공식 Open API (시세·차트·종목 마스터·수급·보유 종목·실시간) ──
# 토스증권 PC 웹(WTS) 로그인 → 설정 → Open API 에서 client_id / client_secret 발급.
# 같은 화면의 "허용 IP 관리"에 이 서버의 공인 IP 를 등록해야 한다(미등록 IP 는 403). /health 의 tossOpenApi.outboundIp 참고.
# 비어 있으면 토스 웹 비공식 API → 네이버 → Yahoo 순으로 동작한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── DART Open API (재무제표, 2단계에서 사용) ───────────
DART_API_KEY=

# ── 네이버 검색 API (뉴스, 2단계에서 사용) ────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 브리핑 생성 모델 ─────────────────────────────────
# 둘 중 하나만 설정하면 된다. 둘 다 있으면 Anthropic 우선 (LLM_PROVIDER=bedrock 으로 강제 가능).
LLM_PROVIDER=auto

# (A) Anthropic 직접: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# (B) Amazon Bedrock (Claude in Amazon Bedrock): AWS 콘솔 → Bedrock → API keys 에서 만든 키
AWS_BEARER_TOKEN_BEDROCK=
# 또는 IAM 액세스 키
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 리전: 도쿄(ap-northeast-1) 권장. 모델 ID 는 anthropic. 접두사 (예: anthropic.claude-opus-4-8, anthropic.claude-sonnet-5)
AWS_REGION=ap-northeast-1
BEDROCK_MODEL=anthropic.claude-opus-4-8

# ── 브리핑 스케줄 (한국 시간, 2단계에서 사용) ──────────
BRIEFING_MORNING_CRON=30 8 * * 1-5
BRIEFING_AFTERNOON_CRON=0 16 * * 1-5

# ── 푸시 알림 (4단계) ────────────────────────────────
# Expo Push Service 는 기본적으로 키가 필요 없다. Expo 계정에서 "Enhanced push security" 를 켠 경우에만 설정.
EXPO_ACCESS_TOKEN=
